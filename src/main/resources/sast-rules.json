[
  {
    "id": "SAST-JAVA-SQL-001",
    "name": "SQL 注入（JDBC 字符串拼接）",
    "category": "sql-injection",
    "severity": "CRITICAL",
    "cwe": "CWE-89",
    "languages": ["java"],
    "message": "检测到通过字符串拼接构造 SQL 语句，若拼接内容包含用户输入，可导致 SQL 注入。",
    "remediation": "使用 PreparedStatement 预编译语句和 ? 占位符传参，禁止拼接 SQL；推荐使用 MyBatis 参数绑定（#{}）或 JPA 参数化查询。",
    "references": ["https://owasp.org/www-community/attacks/SQL_Injection", "https://cwe.mitre.org/data/definitions/89.html"],
    "patterns": [
      {"regex": "(createStatement|prepareStatement|executeQuery|executeUpdate|execute)\\s*\\(\\s*[\"'][^\"']*\\+", "description": "SQL 语句与变量拼接", "confidence": 80},
      {"regex": "String\\.format\\s*\\(\\s*[\"'][^\"']*(SELECT|INSERT|UPDATE|DELETE)[^\"']*[\"']\\s*,\\s*", "description": "String.format 构造 SQL", "confidence": 75},
      {"regex": "\"[^\"]*(SELECT|INSERT|UPDATE|DELETE)[^\"]*\"\\s*\\+\\s*[a-zA-Z_$][\\w$]*", "description": "SQL 常量与变量直接拼接", "confidence": 70}
    ]
  },
